@model List<MvcBlogSite.Models.Post>

<div class="blog-header">
    <h1>Welcome!</h1>
</div>

<div class="post-list">
    <input type="text" id="searchBox" class="search-box" placeholder="Search posts..." />

    @foreach (var post in Model) 
    {
        <div class="post-entry">
            <div class="post-title">
                <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id">
                    @post.Title
                </a>
            </div>
            <div class="post-meta">@post.Author on @post.Date.ToString("MM-dd-yyyy")</div>
        </div>
    }
</div>