@model MvcBlogSite.Models.Post

<div class="blog-header">
    <h1>@Model.Title</h1>
</div>

<p class="post-meta">@Model.Author on @Model.Date.ToString("MM-dd-yyyy")</p>

<div class="post-body">
    @Model.Content
</div>

<div class="post-back">
    <a asp-controller="Posts" asp-action="Index">Back to all posts</a>
</div>