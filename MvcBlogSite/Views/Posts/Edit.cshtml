@model MvcBlogSite.Models.Post

<div class="blog-header">
    <h1>Edit Post</h1>
</div>

<div class="post-list">
    <form asp-controller="Posts" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="post-form">
        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-input" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Author</label>
            <p>@Model.Author</p>
        </div>

        <div class="form-group">
            <label asp-for="Content"></label>
            <textarea asp-for="Content" class="form-input" rows="8">@Model.Content</textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <div class="form-group">
            <button type="submit" class="btn-publish">Save Changes</button>
            <a asp-controller="Posts" asp-action="Details" asp-route-id="@Model.Id" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>